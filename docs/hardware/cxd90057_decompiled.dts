/dts-v1/;

/ {
	compatible = "cxd,cxd90057";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "CXD90057";

	memory@400000000 {
		device_type = "memory";
		reg = <0x04 0x00 0x02 0x00>;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		spi0@F1017000 {
			compatible = "arm,pl022", "arm,primecell";
			reg = <0x00 0xf1017000 0x00 0x1000>;
			interrupts = <0x00 0xc1 0x04>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			num-cs = <0x01>;
			clocks = <0x02 0x0a 0x02 0x61 0x02 0x37 0x02 0x37>;
			clock-names = "spi_clk_parent", "spi_clk_sel", "spi_clk", "apb_pclk";
			resets = <0x03 0xac 0x03 0xad>;
			reset-names = "ssp", "apb";
			status = "okay";

			spidev@0 {
				compatible = "sony,cxd90057";
				reg = <0x00>;
				spi-max-frequency = <0x7a1200>;
			};
		};

		spi1@F1018000 {
			compatible = "arm,pl022", "arm,primecell";
