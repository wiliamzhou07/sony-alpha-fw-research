			device_type = "pci";
			cxd90057,pci32;
			ranges = <0x82000000 0x00 0xc2000000 0x00 0xc2000000 0x00 0x3000000 0xc2000000 0x00 0xc5000000 0x00 0xc5000000 0x00 0x3000000>;
			interrupts = <0x00 0xae 0x04 0x00 0xae 0x04>;
			#interrupt-cells = <0x01>;
			interrupt-map-mask = <0x00 0x00 0x00 0x07>;
			interrupt-map = <0x00 0x00 0x00 0x00 0x01 0x00 0xae 0x04 0x00 0x00 0x00 0x01 0x08 0x00 0x00 0x00 0x00 0x02 0x08 0x01 0x00 0x00 0x00 0x03 0x08 0x02 0x00 0x00 0x00 0x04 0x08 0x03>;
			firm-id = <0x01>;
			num-lanes = <0x01>;
			num-viewport = <0x08>;
			resets = <0x03 0x30 0x03 0x31 0x03 0x32 0x03 0x33 0x03 0x76 0x03 0x77>;
			reset-names = "rst_pwrup", "rst_button", "rst_pe", "rst_apb", "rst_axi2avb_pci", "rst_axi2avb_pci_i0";
			clocks = <0x02 0x52 0x02 0x53 0x02 0x54 0x02 0x55 0x02 0x56 0x02 0x1d 0x02 0x1e>;
			clock-names = "apb_pclk", "dbi_aclk", "slv_aclk", "mstr_aclk", "aux_clk", "axi2avb_pcie0", "axi2avb_pcie1";
			status = "disabled";

			interrupt-controller {
				interrupt-controller;
				#address-cells = <0x00>;
				#interrupt-cells = <0x01>;
				linux,phandle = <0x08>;
				phandle = <0x08>;
			};

			pcie_n_bridge {
				reg = <0x00 0x00 0x00 0x00 0x00>;
				interrupts = <0x00 0xae 0x04>;
			};
		};

		pcie_n_ep {
			compatible = "cxd900xx-pcie-ep";
			memory-region = <0x06>;
			reg = <0x00 0xf6400000 0x00 0x400000 0x00 0xf6500000 0x00 0x10000 0x00 0xf1100000 0x00 0x40000>;
			reg-names = "ctrlreg", "ctrlreg_shadow", "phy_reg";
			interrupts = <0x00 0xae 0x04>;
			firm-id = <0x01>;
			num-lanes = <0x01>;
			num-ib-windows = <0x08>;
			num-ob-windows = <0x08>;
			resets = <0x03 0x30 0x03 0x31 0x03 0x32 0x03 0x33 0x03 0x76 0x03 0x77>;
			reset-names = "rst_pwrup", "rst_button", "rst_pe", "rst_apb", "rst_axi2avb_pci", "rst_axi2avb_pci_i0";
			clocks = <0x02 0x52 0x02 0x53 0x02 0x54 0x02 0x55 0x02 0x56 0x02 0x1d 0x02 0x1e>;
			clock-names = "apb_pclk", "dbi_aclk", "slv_aclk", "mstr_aclk", "aux_clk", "axi2avb_pcie0", "axi2avb_pcie1";
			status = "disabled";
		};

		emmc0 {
			compatible = "arasan,sdhci";
		};

		fec {
			compatible = "dev,fec";
			reg = <0x00 0xf10da000 0x00 0x2000>;
			interrupts = <0x00 0xbf 0x04>;
		};

		spacc@F7FC0000 {
			compatible = "snps,designware-elpmem";
			reg = <0x00 0xf7fc0000 0x00 0x40000>;
			interrupts = <0x00 0xbd 0x04>;
			dma-coherent;
			clocks = <0x02 0x19>;
			resets = <0x03 0x15>;
			status = "okay";
		};

		mdma@F1056000 {
			compatible = "arm,pl330", "arm,primecell";
			reg = <0x00 0xf1056000 0x00 0x1000>;
			interrupts = <0x00 0x50 0x04 0x00 0x51 0x04 0x00 0x52 0x04 0x00 0x53 0x04 0x00 0x54 0x04 0x00 0x55 0x04 0x00 0x56 0x04 0x00 0x57 0x04>;
			clocks = <0x09>;
			clock-names = "apb_pclk";
			status = "disabled";
			#dma-cells = <0x01>;
		};

		mdma@F1057000 {
			compatible = "arm,pl330", "arm,primecell";
			reg = <0x00 0xf1057000 0x00 0x1000>;
			interrupts = <0x00 0x71 0x04 0x00 0x72 0x04 0x00 0x73 0x04 0x00 0x74 0x04 0x00 0x75 0x04 0x00 0x76 0x04 0x00 0x77 0x04 0x00 0x78 0x04>;
			clocks = <0x09>;
			clock-names = "apb_pclk";
			status = "ok";
			#dma-cells = <0x01>;
			arm,pl330-broken-no-flushp;
		};

		usbs {
			compatible = "cxdchip,dwc3";
			reg = <0x00 0xf1080000 0x00 0x1000 0x00 0xf10a0000 0x00 0x1c000>;
			reg-names = "ss_usb", "phy_cr";
			clocks = <0x02 0x13 0x02 0x12 0x02 0x11 0x02 0x10>;
			clock-names = "usb_sus_clk", "usb_axi_clk", "usb_apb_clk", "usb_refclk";
			resets = <0x03 0x0b 0x03 0x0a 0x03 0x09 0x03 0x08>;
			reset-names = "rst_u31", "rst_u2", "rst_apb", "rst_axi";
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges;

			usb@0 {
				compatible = "snps,dwc3";
				reg = <0x00 0xf10c0000 0x00 0x11000>;
				interrupts = <0x00 0xb8 0x04>;
				dr_mode = "otg";
				maximum-speed = "super-speed-plus";
				phy_type = "utmi";
				extcon = <0x0a>;
				status = "okay";
			};
		};
	};

	aliases {
		serial0 = "/soc/serial@f1000000";
		serial1 = "/soc/serial@f1001000";
		serial2 = "/soc/serial@f1002000";
		serial3 = "/soc/serial@f1003000";
		serial4 = "/soc/serial@f1004000";
		spi0 = "/soc/spi0@F1017000";
		spi1 = "/soc/spi1@F1018000";
		spi2 = "/soc/spi2@F1019000";
		spi3 = "/soc/spi3@F101A000";
		spi4 = "/soc/spi4@F101B000";
	};

	iomem@0xf0000000 {
		device_type = "iomap";
		phys = <0x00 0xf0000000>;
		virt = <0xffffffff 0xf0000000>;
		size = <0x00 0xe000000>;
		memtype = <0x01>;
	};

	esram@0xfe000000 {
		device_type = "iomap";
		phys = <0x00 0xfe000000>;
		virt = <0xffffffff 0xfe000000>;
		size = <0x00 0x1000000>;
		memtype = <0x03>;
	};

	iomem2@0xf0000000 {
		device_type = "iomap";
		phys = <0x00 0xff000000>;
		virt = <0xffffffff 0xff000000>;
		size = <0x00 0x1000000>;
		memtype = <0x01>;
	};

	pcie_ep_dummy {
		reg = <0x04 0x00 0x00 0x1000>;
		linux,phandle = <0x06>;
		phandle = <0x06>;
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a35", "arm,armv8";
			reg = <0x00 0x00>;
			next-level-cache = <0x0b>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a35", "arm,armv8";
			reg = <0x00 0x01>;
			next-level-cache = <0x0b>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a35", "arm,armv8";
			reg = <0x00 0x02>;
			next-level-cache = <0x0b>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a35", "arm,armv8";
			reg = <0x00 0x03>;
			next-level-cache = <0x0b>;
			enable-method = "spin-table";
			cpu-release-addr = <0x00 0x00>;
		};

		l2-cache {
			compatible = "cache";
			linux,phandle = <0x0b>;
			phandle = <0x0b>;
		};
	};

	interrupt-controller@f13A0000 {
		compatible = "arm,gic-400";
		#interrupt-cells = <0x03>;
		interrupt-controller;
		linear-map;
		reg = <0x00 0xf13a1000 0x00 0x1000 0x00 0xf13a2000 0x00 0x2000 0x00 0xf13a4000 0x00 0x2000 0x00 0xf13a6000 0x00 0x2000>;
		interrupts = <0x01 0x09 0x308>;
		linux,phandle = <0x01>;
		phandle = <0x01>;
	};

	pmu {
		compatible = "arm,armv8-pmuv3";
		interrupts = <0x00 0xf0 0x04 0x00 0xf1 0x04 0x00 0xf2 0x04 0x00 0xf3 0x04>;
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <0x01>;
		interrupts = <0x01 0x0d 0x308 0x01 0x0e 0x308 0x01 0x0b 0x308 0x01 0x0a 0x308>;
		clock-frequency = <0x1e8480>;
	};

	chosen {
		stdout-path = "serial0:460800n8";
	};
};
